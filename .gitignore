# Data layers (Bronze/Silver raw + DuckDB are reproducible artifacts)
# NOTE: git cannot re-include a file if a parent dir is excluded by name,
# so we use per-level whitelisting: data/* then data/gold/* etc.
data/*
!data/gold
data/gold/*
!data/gold/exports

# Historical SATCAT year files are immutable once their year completes and
# are committed so ephemeral CI runners never re-sweep 1957..last-year.
# The current year's file is kept OUTSIDE years/ (data/bronze/satcat/) by
# fetch_bronze.py precisely so it stays ignored by data/bronze/satcat/*.
!data/bronze
data/bronze/*
!data/bronze/satcat
data/bronze/satcat/*
!data/bronze/satcat/years

# Python
__pycache__/
*.pyc
.venv/
venv/

# Environment / secrets
.env
.env.*

# OS
Thumbs.db
.DS_Store
